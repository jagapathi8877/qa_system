# Copy to .env, supply authorized keys locally, then restart the server.
# Empty slots are ignored. Never commit .env. Project IDs are declarations,
# not proof of ownership and do not alter the API key's quota scope.
GEMINI_API_KEY_1=
GEMINI_PROJECT_ID_1=
GEMINI_ACCOUNT_LABEL_1=
GEMINI_API_KEY_2=
GEMINI_PROJECT_ID_2=
GEMINI_ACCOUNT_LABEL_2=
GEMINI_API_KEY_3=
GEMINI_PROJECT_ID_3=
GEMINI_ACCOUNT_LABEL_3=

QNEXT_AI_ENABLED=true
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Optional per-slot subset, comma separated; defaults to GEMINI_MODELS.
# GEMINI_MODELS_1=gemini-3.8-flash,gemini-3.6-flash
GEMINI_THINKING_LEVEL=auto
GEMINI_TEMPERATURE=0.2
GEMINI_ATTEMPT_TIMEOUT=8
GEMINI_DEADLINE=20
GEMINI_MAX_ATTEMPTS=4
GEMINI_BACKOFF=0.4
GEMINI_COOLDOWN=30
GEMINI_AUTH_COOLDOWN=300
GEMINI_MAX_OUTPUT_TOKENS=1800
GEMINI_CONTEXT_CHARS=10000
GEMINI_MAX_PASSAGES=6
# Required for production: supply a private random value of at least 32 chars.
# QUILLQA_ENV=production
# QUILLQA_SECRET=
